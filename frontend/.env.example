# Padrão para desenvolvimento e preview local: /api passa pelo proxy do Vite.
VITE_API_URL=/api

# Se a API usar outra porta, ajuste também PORT no backend/.env.
VITE_API_PROXY_TARGET=http://localhost:3000

# Em hospedagem com domínios separados, VITE_API_URL deve incluir /api:
# VITE_API_URL=https://api.exemplo.com/api
# Variáveis VITE_* são públicas no navegador. Não coloque segredos aqui.
